# DomainSpider 环境变量配置示例
# 复制此文件为 .env 并修改相应的值
# 
# 使用场景：
# 1. 本地开发：直接使用 .env 文件
# 2. Scrapyd：start_scrapyd.sh 会自动加载 .env
# 3. 生产环境：使用系统环境变量或容器环境变量

# ==================== 数据库配置 ====================
# PostgreSQL 连接（必填）
POSTGRES_URL=postgresql://postgres:password@127.0.0.1:5432/domain_spider

# ==================== 日志配置 ====================
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/scrapy.log

# ==================== 代理配置 ====================
# 是否启用代理（本地开发建议关闭）
PROXY_ENABLED=false
PROXY_API_URL=http://localhost:5010/get

# ==================== 输出配置 ====================
OUTPUT_DIR=/tmp/scrapy_output
OUTPUT_FORMAT=jsonlines

# ==================== Redis 配置（可选）====================
# 如果使用分布式爬虫，需要配置 Redis
# REDIS_URL=redis://localhost:6379

# ==================== 并发配置（可选）====================
# 如果需要覆盖 base.yaml 中的默认值
# CONCURRENT_REQUESTS=16
# DOWNLOAD_DELAY=1
